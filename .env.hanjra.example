# Copy selected values into .env.local. No credentials belong in this example.
HANJRA_PROVIDER=ollama
HANJRA_OLLAMA_MODEL=qwen3.5:0.8b
HANJRA_OLLAMA_URL=http://127.0.0.1:11434/v1
HANJRA_ALLOW_CLOUD_TEXT=false
# Optional cloud configuration: explicit provider, model, conservative unit price and daily cap.
HANJRA_MODEL=
HANJRA_USD_PER_MILLION_TOKENS=
HANJRA_DAILY_BUDGET_USD=1
HANJRA_DATABASE_PATH=
HANJRA_ALLOWED_ROOTS=
HANJRA_CAREER_ROOT=
HANJRA_AUTOMATION_ROOT=
# A Python executable with existing faster-whisper, PyYAML and python-docx.
HANJRA_PYTHON=
HANJRA_WHISPER_MODEL_DIR=
HANJRA_WINDOWS_VOICE=Microsoft David Desktop
# Optional separate VoiceStudio service; verify installed capabilities before selecting models/profiles.
HANJRA_VOICESTUDIO_URL=http://127.0.0.1:3900
HANJRA_VOICESTUDIO_STT_MODEL=
HANJRA_VOICESTUDIO_TTS_MODEL=
HANJRA_TTS_VOICE_EN=
HANJRA_TTS_VOICE_HI=
HANJRA_TTS_VOICE_PA=
# Original voice design brief for a future verified VoiceStudio profile:
# Warm composed adult voice, neutral clear delivery, concise progress, lightly witty.
# Original identity; no imitation of a named actor. Identity across languages requires listening tests.
