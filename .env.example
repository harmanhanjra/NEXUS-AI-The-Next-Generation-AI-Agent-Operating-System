OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b
NEXUS_DISABLE_EMBEDDINGS=false
ALLOW_LOCAL_PROVIDER_URLS=false

# Optional extra installed-skill folders, separated by semicolons.
NEXUS_SKILL_PATHS=
NEXUS_DISABLE_LOCAL_SKILLS=false
# Optional: set both to use a persistent remote libSQL/Turso database.
# Without DATABASE_URL, documents are saved to ./data/nexus-documents.sqlite.
DATABASE_URL=
DATABASE_AUTH_TOKEN=
# Optional local database path override.
NEXUS_DATABASE_PATH=
